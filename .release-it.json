{
	"$schema": "https://unpkg.com/release-it@17/schema/release-it.json",
	"plugins": {
		"@release-it/conventional-changelog": {
			"preset": {
				"name": "angular"
			},
			"infile": "CHANGELOG.md"
		}
	},
	"git": {
		"tag": false,
		"tagName": "v${version}",
		"tagMatch": "v*",
		"commit": false,
		"push": false,
		"requireUpstream": false
	},
	"npm": {
		"publish": false
	},
	"hooks": {
		"before:bump": "node ./scripts/pre-release.js ${version}",
		"after:release": "node ./scripts/post-release.js"
	}
}
